{
  "name": "openai-pr-reviewer",
  "version": "0.0.0",
  "private": true,
  "description": "Line-by-line GitHub pull request reviewer and summarizer.",
  "main": "lib/main.js",
  "scripts": {
    "build": "mkdir -p dist && cp node_modules/@dqbd/tiktoken/tiktoken_bg.wasm dist/tiktoken_bg.wasm && tsc",
    "package": "ncc build lib/main.js --license licenses.txt -o dist",
    "act": "npm run build && npm run package && act pull_request --secret-file .secrets",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test && npm run test:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stuhlmuller/ai-pr-reviewer.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@anthropic-ai/sdk": "^0.82.0",
    "@dqbd/tiktoken": "^1.0.22",
    "@octokit/action": "^8.0.4",
    "@octokit/plugin-retry": "^8.0.3",
    "@octokit/plugin-throttling": "^11.0.3",
    "minimatch": "^10.1.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.104.0",
    "p-limit": "^7.2.0",
    "p-retry": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.4",
    "@eslint/eslintrc": "3.3.5",
    "@jest/globals": "30.3.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/node": "25.5.2",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "8.58.0",
    "@vercel/ncc": "0.38.4",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-github": "6.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.1",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "7.2.1",
    "globals": "17.4.0",
    "jest": "30.3.0",
    "js-yaml": "4.1.1",
    "prettier": "3.8.1",
    "ts-jest": "29.4.9",
    "typescript": "6.0.2"
  }
}
